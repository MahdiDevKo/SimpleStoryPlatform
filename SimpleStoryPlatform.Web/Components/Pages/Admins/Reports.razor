    private async Task LoadMoreWarnings(UserWithWarningsDto user)
    {
        try
        {
            if(user.Warnings != null && user.Warnings.Count < 3 && user.Warnings.Count > 0)
            {
                msgService.ShowMessage("you aleready can see all of user's warnings...");
                return;
            }

            //calculation the page by PAGESIZE: 3
            int nextPage = ((user.Warnings?.Count ?? 0) / 3) + 1;

            msgService.ShowMessage($"Loading page {nextPage} of warnings...", "info");

            var req = new WarningPageRequestDto(){
                UserGuid = user.PublicId,
                Page = nextPage
            };

            var apiRes = await clientAli.GetUserWarningsAsync(req);

            if (!apiRes.Success) {msgService.ShowMessage($"Error: {apiRes.Message}", "error"); return; }
            if (apiRes.Items?.Count == 0) {msgService.ShowMessage($"you already can see all of the warnings...", "error"); return; }
            
            var newWarnings = user.Warnings != null         //new list
                ? new List<WarningDto>(user.Warnings) 
                : new List<WarningDto>();
            
            newWarnings.AddRange(apiRes.Items);             //adding new items
            
            user.Warnings = newWarnings;                    //assign new warnings list
            
            StateHasChanged();                              //done
            
            msgService.ShowMessage($"Loaded {apiRes.Items.Count} warnings", "success");
           
                
        }
        catch (Exception e)
        {

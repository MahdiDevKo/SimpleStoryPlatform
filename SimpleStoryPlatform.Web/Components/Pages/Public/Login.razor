    }

    /* Form Inputs */
    .form-group {
        margin-bottom: 30px;
    }

    .input-group {
        position: relative;
        margin-bottom: 20px;
    }

        .input-group.half {
            width: calc(50% - 10px);
        }

    .name-row, .password-row {
        display: flex;
        gap: 20px;
    }

    .input-icon {
        position: absolute;

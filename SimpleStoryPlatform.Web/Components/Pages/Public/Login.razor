@page "/login"
@rendermode InteractiveServer
@inject IJSRuntime JS

<div class="auth-page">
    <!-- Main Container -->
    <div class="auth-container">
        <!-- Left Side - Welcome -->
        <div class="auth-welcome">
            <div class="welcome-content">
                <div class="logo">
                    <span class="logo-icon">📚</span>
                    <h1>StoryVerse</h1>
                </div>
                <h2>Welcome Back!</h2>
                <p class="welcome-text">
                    @(isLogin
                                        ? "Sign in to access your personal library and continue your reading journey."
                                        : "Join our community of readers and writers to discover amazing stories.")
                </p>
                <div class="features">
                    <div class="feature">
                        <span class="feature-icon">🌟</span>
                        <span>Personalized library</span>
                    </div>
                    <div class="feature">
                        <span class="feature-icon">📖</span>
                        <span>Save reading progress</span>
                    </div>
                    <div class="feature">
                        <span class="feature-icon">✍️</span>
                        <span>Create your own stories</span>
                    </div>
                </div>
            </div>
        </div>

        <!-- Right Side - Form -->
        <div class="auth-form">
            <!-- Header -->
            <div class="form-header">
                <h2>@(isLogin ? "Sign In" : "Create Account")</h2>
                <p class="form-subtitle">
                    @(isLogin
                                        ? "Enter your credentials to continue"
                                        : "Fill in your details to get started")
                </p>
            </div>

            <!-- Messages -->
            @if (!string.IsNullOrEmpty(errorText))
            {
                <div class="error-message">
                    <span class="error-icon">⚠️</span>
                    <span>@errorText</span>
                </div>
            }

            @if (!string.IsNullOrEmpty(SuckText))
            {
                <div class="success-message">
                    <span class="success-icon">✅</span>
                    <span>@SuckText</span>
                </div>
            }

            <!-- Login Form -->
            @if (isLogin)
            {
                <div class="form-group">
                    <div class="input-group">
                        <span class="input-icon">👤</span>
                        <input type="text"
                               class="form-input"
                               @bind="loginDto.Username"
                               @bind:event="oninput"
                               placeholder="Username" />
                    </div>

                    <div class="input-group">
                        <span class="input-icon">🔒</span>
                        <input type="password"
                               class="form-input"
                               @bind="loginDto.Password"
                               @bind:event="oninput"
                               placeholder="Password" />
                    </div>
                </div>
            }
            else
            {
                <!-- Register Form -->
                <div class="form-group">
                    <div class="name-row">
                        <div class="input-group half">
                            <span class="input-icon">👤</span>
                            <input type="text"
                                   class="form-input"
                                   @bind="createDto.FirstName"
                                   @bind:event="oninput"
                                   placeholder="First Name" />
                        </div>

                        <div class="input-group half">
                            <span class="input-icon">👥</span>
                            <input type="text"
                                   class="form-input"
                                   @bind="createDto.LastName"
                                   @bind:event="oninput"
                                   placeholder="Last Name" />
                        </div>
                    </div>

                    <div class="input-group">
                        <span class="input-icon">📧</span>
                        <input type="email"
                               class="form-input"
                               @bind="createDto.Email"
                               @bind:event="oninput"
                               placeholder="Email Address" />
                    </div>

                    <div class="input-group">
                        <span class="input-icon">👤</span>
                        <input type="text"
                               class="form-input"
                               @bind="createDto.Username"
                               @bind:event="oninput"
                               placeholder="Username" />
                    </div>

                    <div class="password-row">
                        <div class="input-group half">
                            <span class="input-icon">🔒</span>
                            <input type="password"
                                   class="form-input"
                                   @bind="createDto.Password"
                                   @bind:event="oninput"
                                   placeholder="Password" />
                        </div>

                        <div class="input-group half">
                            <span class="input-icon">🔐</span>
                            <input type="password"
                                   class="form-input"
                                   @bind="createDto.PasswordTwo"
                                   @bind:event="oninput"
                                   placeholder="Confirm Password" />
                        </div>
                    </div>
                </div>
            }

            <!-- Submit Button -->
            <button class="submit-btn" @onclick="GetRequestAsync">
                <span class="btn-icon">@(isLogin ? "🔑" : "✨")</span>
                <span>@submitText</span>
            </button>

            <!-- Switch Mode -->
            <div class="switch-mode">
                <p class="switch-text">
                    @changeButtonText
                    <a @onclick="ChangeMethod" class="switch-link">
                        @(isLogin ? "Sign Up" : "Sign In")
                    </a>
                </p>
            </div>

            <!-- Footer Links -->
            <div class="auth-footer">
                <a href="/" class="footer-link">← Back to Home</a>
                @if (isLogin)
                {
                    <a href="#" class="footer-link">Forgot Password?</a>
                }
            </div>
        </div>
    </div>
</div>

<style>
    /* Page Layout */
    .auth-page {
        min-height: 100vh;
        display: flex;
        align-items: center;
        justify-content: center;
        background: linear-gradient(135deg, #667eea 0%, #764ba2 100%);
        padding: 20px;
    }

    .auth-container {
        display: flex;
        width: 100%;
        max-width: 1000px;
        background: white;
        border-radius: 20px;
        overflow: hidden;
        box-shadow: 0 15px 50px rgba(0, 0, 0, 0.2);
        min-height: 600px;
    }

    /* Left Side - Welcome */
    .auth-welcome {
        flex: 1;
        background: linear-gradient(135deg, #4a6bff 0%, #3a5bef 100%);
        color: white;
        padding: 50px 40px;
        display: flex;
        flex-direction: column;
        justify-content: center;
    }

    .welcome-content {
        max-width: 400px;
        margin: 0 auto;
    }

    .logo {
        display: flex;
        align-items: center;
        gap: 15px;
        margin-bottom: 40px;
    }

    .logo-icon {
        font-size: 3.5rem;
    }

    .logo h1 {
        font-size: 2.2rem;
        font-weight: 800;
        margin: 0;
        letter-spacing: -0.5px;
    }

    .auth-welcome h2 {
        font-size: 2rem;
        margin-bottom: 20px;
        font-weight: 700;
    }

    .welcome-text {
        font-size: 1.1rem;
        line-height: 1.6;
        opacity: 0.9;
        margin-bottom: 40px;
    }

    .features {
        display: flex;
        flex-direction: column;
        gap: 20px;
    }

    .feature {
        display: flex;
        align-items: center;
        gap: 15px;
    }

    .feature-icon {
        font-size: 1.5rem;
        background: rgba(255, 255, 255, 0.1);
        width: 45px;
        height: 45px;
        border-radius: 50%;
        display: flex;
        align-items: center;
        justify-content: center;
    }

    .feature span:last-child {
        font-size: 1rem;
        font-weight: 500;
    }

    /* Right Side - Form */
    .auth-form {
        flex: 1;
        padding: 50px 40px;
        display: flex;
        flex-direction: column;
        justify-content: center;
    }

    .form-header {
        margin-bottom: 30px;
    }

        .form-header h2 {
            font-size: 2.2rem;
            color: #2d3748;
            margin-bottom: 10px;
            font-weight: 700;
        }

    .form-subtitle {
        color: #718096;
        font-size: 1rem;
        margin: 0;
    }

    /* Messages */
    .error-message {
        background: #fff5f5;
        border: 1px solid #fed7d7;
        border-radius: 10px;
        padding: 15px;
        margin-bottom: 25px;
        display: flex;
        align-items: center;
        gap: 12px;
        animation: slideIn 0.3s ease;
    }

    .error-icon {
        color: #e53e3e;
        font-size: 1.2rem;
    }

    .success-message {
        background: #f0fff4;
        border: 1px solid #c6f6d5;
        border-radius: 10px;
        padding: 15px;
        margin-bottom: 25px;
        display: flex;
        align-items: center;
        gap: 12px;
        animation: slideIn 0.3s ease;
    }

    .success-icon {
        color: #38a169;
        font-size: 1.2rem;
    }

    @@keyframes slideIn {
        from

    {
        opacity: 0;
        transform: translateY(-10px);
    }

    to {
        opacity: 1;
        transform: translateY(0);

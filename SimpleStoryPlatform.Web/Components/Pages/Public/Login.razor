        }

    .btn-icon {
        font-size: 1.3rem;
    }

    /* Switch Mode */
    .switch-mode {
        text-align: center;
        margin-bottom: 30px;
    }

    .switch-text {
        color: #718096;
        font-size: 1rem;
        margin: 0;
    }

    .switch-link {
        color: #4a6bff;
        text-decoration: none;
        font-weight: 600;
        cursor: pointer;
        margin-left: 8px;
        transition: color 0.3s ease;
    }

        .switch-link:hover {
            color: #3a5bef;
            text-decoration: underline;
        }

    /* Footer Links */
    .auth-footer {
        display: flex;
        justify-content: space-between;
        padding-top: 20px;
        border-top: 1px solid #e2e8f0;
    }

    .footer-link {
        color: #718096;
        text-decoration: none;
        font-size: 0.9rem;
        transition: color 0.3s ease;
    }

        .footer-link:hover {
            color: #4a6bff;
        }

    /* Responsive Design */
    @@media (max-width: 768px) {
        .auth-container

    {
        flex-direction: column;
        max-width: 450px;
    }

    .auth-welcome {
        padding: 30px 25px;
    }

    .auth-form {
        padding: 30px 25px;
    }

    .name-row, .password-row {
        flex-direction: column;
        gap: 0;
    }

    .input-group.half {
        width: 100%;
    }

    .logo {
        justify-content: center;
        text-align: center;
        flex-direction: column;
        gap: 10px;
    }

        .logo h1 {
            font-size: 1.8rem;
        }

    .auth-welcome h2 {
        font-size: 1.6rem;
        text-align: center;
    }

    .welcome-text {
        text-align: center;
    }

    .feature {
        justify-content: center;
    }

    .form-header h2 {
        font-size: 1.8rem;
        text-align: center;
    }

    .form-subtitle {
        text-align: center;
    }

    .auth-footer {
        flex-direction: column;
        gap: 15px;
        align-items: center;
    }

    }
</style>

@code {
    bool isLogin = true;
    string submitText = "Sign In";
    string changeButtonText = "Don't have an account?";
    string errorText = "";
    string SuckText = "";

    UserCreateDto createDto = new UserCreateDto();
    UserLoginDto loginDto = new UserLoginDto();

    void ChangeMethod()
    {
        isLogin = !isLogin;
        if (isLogin)
        {
            submitText = "Sign In";
            changeButtonText = "Don't have an account?";
        }
        else
        {
            submitText = "Sign Up";
            changeButtonText = "Already have an account?";
        }

        // Clear messages when switching modes
        errorText = "";
        SuckText = "";
    }

    async Task GetRequestAsync()
    {
        if (isLogin)
        {
            await HandleLogin();
        }
        else
        {
            await HandleSignup();
        }
    }

    async Task HandleLogin()
    {
        try
        {
            var result = await clientAli.LoginAsync(loginDto);

            if (result.Success)
            {
                await SaveToken(result.Data);
            }
            else
            {
                errorText = result.Message;
                msgService.ShowMessage(result.Message, "error");
            }
        }
        catch (Exception e)
        {
            errorText = e.Message;
            msgService.ShowMessage(e.Message, "error");
        }
    }

    async Task HandleSignup()
    {
        try
        {
            var result = await clientAli.SignupAsync(createDto);

            if (result.Success)
            {
                await SaveToken(result.Data);
            }
            else
            {
                errorText = result.Message;
                msgService.ShowMessage(result.Message, "error");
            }
        }
        catch (Exception e)
        {
            errorText = e.Message;
            msgService.ShowMessage(e.Message, "error");
        }
    }

    async Task SaveToken(string token)
    {
        await JS.InvokeVoidAsync("eval",
            $"document.cookie = 'Token={token}; path=/; max-age=43200; secure; samesite=strict'");

        Navigation.NavigateTo("/", forceLoad: true);
    }
}
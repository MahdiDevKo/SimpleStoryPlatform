@page "/"
@page "/home"
@rendermode InteractiveServer

<div class="home-container">
    <!-- Hero Section -->
    <div class="hero-section">
        <h1 class="hero-title">📖 StoryVerse</h1>
        <p class="hero-subtitle">Discover amazing stories from talented writers</p>

        <!-- Search Bar -->
        <div class="search-bar">
            <input type="text"
                   class="search-input"
                   placeholder="Search for stories, writers, or keywords..."
                   @bind="optionsDto.Options.StoryName"
                   @bind:event="oninput" />
            <button class="search-btn" @onclick="() => LoadPage(1)">
                🔍 Search
            </button>
        </div>
    </div>

    <!-- Advanced Filters -->
    <div class="filters-section">
        <div class="filters-header">
            <h3>🔎 Advanced Filters</h3>
            <button class="clear-filters-btn" @onclick="ClearFilters">
                🗑️ Clear All
            </button>
        </div>

        <div class="filters-grid">
            <!-- Writer Username -->
            <div class="filter-group">
                <label class="filter-label">👤 Writer Username</label>
                <input type="text"
                       class="filter-input"
                       placeholder="Enter writer username..."
                       @bind="optionsDto.Options.WriterUsername" />
            </div>

            <!-- Date Range -->
            <div class="filter-group">
                <label class="filter-label">📅 Date Range</label>
                <div class="date-range">
                    <input type="date"
                           class="date-input"
                           @bind="optionsDto.Options.CreatedDateFrom"
                           @bind:format="yyyy-MM-dd" />
                    <span class="date-separator">to</span>
                    <input type="date"
                           class="date-input"
                           @bind="optionsDto.Options.CreatedDateTo"
                           @bind:format="yyyy-MM-dd" />
                </div>
            </div>

            <!-- Apply Filters Button -->
            <div class="filter-group">
                <button class="apply-filters-btn" @onclick="() => LoadPage(1)">
                    ✅ Apply Filters
                </button>
            </div>
        </div>
    </div>

    <!-- Content Section -->
    <div class="content-section">
        <!-- Loading State -->
        @if (pageResponse == null)
        {
            <div class="loading-state">
                <div class="spinner"></div>
                <p>Loading stories...</p>
            </div>
        }
        else if (!pageResponse.Success)
        {
            <!-- Error State -->
            <div class="error-state">
                <div class="error-icon">⚠️</div>
                <h3>Oops! Something went wrong</h3>
                <p>@pageResponse.Message</p>
                @if (pageResponse.Errors?.Any() == true)
                {
                    <div class="error-details">
                        @foreach (var error in pageResponse.Errors)
                        {
                            <span class="error-item">• @error</span>
                        }
                    </div>
                }
                <button class="retry-btn" @onclick="() => LoadPage(1)">
                    🔄 Retry
                </button>
            </div>
        }
        else if (pageResponse.Items == null || !pageResponse.Items.Any())
        {
            <!-- Empty State -->
            <div class="empty-state">
                <div class="empty-icon">🔍</div>
                <h3>No stories found</h3>
                <p>Try adjusting your search criteria or browse latest stories</p>
                <button class="browse-btn" @onclick="ClearFilters">
                    📚 Browse Latest Stories
                </button>
            </div>
        }
        else
        {
            <!-- Results Section -->
            <div class="results-section">
                <!-- Results Header -->
                <div class="results-header">
                    <h2>📚 Stories Found</h2>
                    <div class="results-meta">
                        <span class="results-count">
                            Showing @pageResponse.Items.Count() of @pageResponse.TotalItems results
                        </span>
                        <span class="page-info">
                            Page @pageResponse.CurrentPage of @pageResponse.TotalPages
                        </span>
                    </div>
                </div>

                <!-- Stories Grid -->
                <div class="stories-grid">
                    @foreach (var story in pageResponse.Items)
                    {
                        <div class="story-card">
                            <!-- Story Header -->
                            <div class="story-card-header">
                                <h3 class="story-title">@story.Name</h3>
                                <div class="story-meta">
                                    <span class="story-date">
                                        📅 @story.CreatedAt.ToString("MMM dd, yyyy")
                                    </span>
                                </div>
                            </div>

                            <!-- Story Preview -->
                            <div class="story-preview">
                                <p>@(story.Preview.Length > 120 ? story.Preview.Substring(0, 120) + "..." : story.Preview)</p>
                            </div>

                            <!-- Author Info -->
                            <div class="author-section">
                                <div class="author-info">
                                    <span class="author-label">👤 Author:</span>
                                    <a href="/user-profile/@story.CreatedBy"
                                       class="author-name">
                                        @story.Writer.FirstName @story.Writer.LastName
                                    </a>
                                </div>
                                <span class="author-username">
                                    @@@story.Writer.Username
                                </span>
                            </div>

                            <!-- Action Buttons -->
                            <div class="story-actions">
                                <!-- Read Button -->
                                <a href="/ReadStory/@story.PublicId"
                                   class="action-btn btn-read">
                                    📖 Read Story
                                </a>

                                <!-- Playlist Button (if available) -->
                                @if (story.PlayListGuid.HasValue)
                                {
                                    <a href="/StoryPlayList/@story.PlayListGuid"
                                       class="action-btn btn-playlist">
                                        🎵 View Playlist
                                    </a>
                                }

                                <!-- Story ID Info -->
                                <span class="story-id">
                                    ID: @story.PublicId.ToString("N")[..8]...
                                </span>
                            </div>
                        </div>
                    }
                </div>

                <!-- Pagination -->
                @if (pageResponse.TotalPages > 1)
                {
                    <div class="pagination">
                        <!-- Previous Button -->
                        <button class="pagination-btn @(pageResponse.CurrentPage <= 1 ? "disabled" : "")"
                                @onclick="() => LoadPage(pageResponse.CurrentPage - 1)"
                                disabled="@(pageResponse.CurrentPage <= 1)">
                            ◀ Previous
                        </button>

                        <!-- Page Numbers -->
                        <div class="page-numbers">
                            @{
                                var startPage = Math.Max(1, pageResponse.CurrentPage - 2);
                                var endPage = Math.Min(pageResponse.TotalPages, pageResponse.CurrentPage + 2);
                            }

                            @for (int i = startPage; i <= endPage; i++)
                            {
                                <button class="page-number @(i == pageResponse.CurrentPage ? "active" : "")"
                                        @onclick="() => LoadPage(i)">
                                    @i
                                </button>
                            }

                            @if (endPage < pageResponse.TotalPages)
                            {
                                <span class="page-ellipsis">...</span>
                                <button class="page-number"
                                        @onclick="() => LoadPage(pageResponse.TotalPages)">
                                    @pageResponse.TotalPages
                                </button>
                            }
                        </div>

                        <!-- Next Button -->
                        <button class="pagination-btn @(pageResponse.CurrentPage >= pageResponse.TotalPages ? "disabled" : "")"
                                @onclick="() => LoadPage(pageResponse.CurrentPage + 1)"
                                disabled="@(pageResponse.CurrentPage >= pageResponse.TotalPages)">
                            Next ▶
                        </button>
                    </div>
                }

                <!-- Results Footer -->
                <div class="results-footer">
                    <div class="results-stats">
                        <div class="stat-item">
                            <span class="stat-label">Total Stories:</span>
                            <span class="stat-value">@pageResponse.TotalItems</span>
                        </div>
                        <div class="stat-item">
                            <span class="stat-label">Current Page:</span>
                            <span class="stat-value">@pageResponse.CurrentPage</span>
                        </div>
                        <div class="stat-item">
                            <span class="stat-label">Page Size:</span>
                            <span class="stat-value">@pageResponse.PageSize</span>
                        </div>
                        <div class="stat-item">
                            <span class="stat-label">Total Pages:</span>
                            <span class="stat-value">@pageResponse.TotalPages</span>
                        </div>
                    </div>
                </div>
            </div>
        }
    </div>
</div>

<style>
    /* Main Container */
    .home-container {
        max-width: 1400px;
        margin: 0 auto;
        padding: 20px;
        font-family: 'Segoe UI', Tahoma, Geneva, Verdana, sans-serif;
    }

    /* Hero Section */
    .hero-section {
        text-align: center;
        padding: 50px 20px;
        background: linear-gradient(135deg, #667eea 0%, #764ba2 100%);
        border-radius: 20px;
        color: white;
        margin-bottom: 30px;
        box-shadow: 0 10px 30px rgba(102, 126, 234, 0.3);
    }

    .hero-title {
        font-size: 3.5rem;
        font-weight: 800;
        margin-bottom: 10px;
        letter-spacing: -0.5px;
    }

    .hero-subtitle {
        font-size: 1.3rem;
        opacity: 0.9;
        margin-bottom: 30px;
        font-weight: 300;
    }

    /* Search Bar */
    .search-bar {
        display: flex;
        max-width: 700px;
        margin: 0 auto;
        gap: 10px;
    }

    .search-input {
        flex: 1;
        padding: 15px 20px;
        border: none;
        border-radius: 50px;
        font-size: 1.1rem;
        outline: none;
        box-shadow: 0 4px 15px rgba(0, 0, 0, 0.1);
    }

    .search-btn {
        background: #38a169;
        color: white;
        border: none;
        padding: 15px 30px;
        border-radius: 50px;
        font-size: 1.1rem;
        font-weight: 600;
        cursor: pointer;
        display: flex;
        align-items: center;
        gap: 8px;
        transition: all 0.3s ease;
        box-shadow: 0 4px 15px rgba(56, 161, 105, 0.3);
    }

        .search-btn:hover {
            background: #2f855a;
            transform: translateY(-2px);
            box-shadow: 0 6px 20px rgba(56, 161, 105, 0.4);
        }

    /* Filters Section */
    .filters-section {
        background: white;
        border-radius: 15px;
        padding: 25px;
        margin-bottom: 30px;
        box-shadow: 0 4px 20px rgba(0, 0, 0, 0.05);
        border: 1px solid #e2e8f0;
    }

    .filters-header {
        display: flex;
        justify-content: space-between;
        align-items: center;
        margin-bottom: 20px;
        padding-bottom: 15px;
        border-bottom: 2px solid #f1f5f9;
    }

        .filters-header h3 {
            margin: 0;
            color: #2d3748;
            font-size: 1.3rem;
            display: flex;
            align-items: center;
            gap: 10px;
        }

    .clear-filters-btn {
        background: #e53e3e;
        color: white;
        border: none;
        padding: 8px 16px;
        border-radius: 6px;
        font-size: 0.9rem;
        cursor: pointer;
        display: flex;
        align-items: center;
        gap: 6px;
        transition: background 0.3s ease;
    }

        .clear-filters-btn:hover {
            background: #c53030;
        }

    .filters-grid {
        display: grid;
        grid-template-columns: repeat(auto-fit, minmax(250px, 1fr));
        gap: 20px;
    }

    .filter-group {
        display: flex;
        flex-direction: column;
        gap: 8px;
    }

    .filter-label {
        font-weight: 600;
        color: #4a5568;
        font-size: 0.95rem;
        display: flex;
        align-items: center;
        gap: 6px;
    }

    .filter-input, .date-input {
        padding: 12px 15px;
        border: 1px solid #e2e8f0;
        border-radius: 8px;
        font-size: 0.95rem;
        transition: border-color 0.3s ease;
    }

        .filter-input:focus, .date-input:focus {
            outline: none;
            border-color: #4a6bff;
            box-shadow: 0 0 0 3px rgba(74, 107, 255, 0.1);
        }

    .date-range {
        display: flex;
        align-items: center;
        gap: 10px;
    }

    .date-separator {
        color: #718096;
        font-weight: 500;
    }

    .apply-filters-btn {
        background: #4a6bff;
        color: white;
        border: none;
        padding: 12px 20px;
        border-radius: 8px;
        font-weight: 600;
        cursor: pointer;
        margin-top: 10px;
        display: flex;
        align-items: center;
        justify-content: center;
        gap: 8px;
        transition: all 0.3s ease;
    }

        .apply-filters-btn:hover {
            background: #3a5bef;
            transform: translateY(-2px);
        }

    /* Content Section */
    .content-section {
        margin-top: 20px;
    }

    /* Loading State */
    .loading-state {
        display: flex;
        flex-direction: column;
        align-items: center;
        justify-content: center;
        padding: 80px 20px;
    }

    .spinner {
        width: 60px;
        height: 60px;
        border: 5px solid #f3f3f3;
        border-top: 5px solid #667eea;
        border-radius: 50%;
        animation: spin 1s linear infinite;
        margin-bottom: 20px;
    }

    @@keyframes spin {
        0% {
            transform: rotate(0deg);
        }

        100% {
            transform: rotate(360deg);
        }
    }

    .loading-state p {
        color: #666;
        font-size: 1.2rem;
    }

    /* Error State */
    .error-state {
        background: #fff5f5;
        border: 1px solid #fed7d7;
        border-radius: 15px;
        padding: 50px 30px;
        text-align: center;
        margin: 30px 0;
    }

    .error-icon {
        font-size: 3.5rem;
        margin-bottom: 20px;
    }

    .error-state h3 {
        color: #c53030;
        margin-bottom: 15px;
        font-size: 1.5rem;
    }

    .error-state p {
        color: #718096;
        margin-bottom: 25px;
        font-size: 1.1rem;
    }

    .error-details {
        margin: 20px 0;
        text-align: left;
        background: white;
        padding: 20px;
        border-radius: 10px;
        border-left: 4px solid #c53030;
        max-width: 600px;
        margin-left: auto;
        margin-right: auto;
    }

    .error-item {
        display: block;
        color: #e53e3e;
        padding: 5px 0;
        font-size: 0.95rem;
    }

    .retry-btn {
        background: #e53e3e;
        color: white;
        border: none;
        padding: 12px 28px;
        border-radius: 8px;
        font-weight: 600;
        cursor: pointer;
        margin-top: 20px;
        display: inline-flex;
        align-items: center;
        gap: 10px;
        transition: background 0.3s ease;
        font-size: 1rem;
    }

        .retry-btn:hover {
            background: #c53030;
        }

    /* Empty State */
    .empty-state {
        background: #f8f9fa;
        border: 2px dashed #dee2e6;
        border-radius: 15px;
        padding: 70px 40px;
        text-align: center;
    }

    .empty-icon {
        font-size: 4.5rem;
        margin-bottom: 25px;
        opacity: 0.5;
    }

    .empty-state h3 {
        color: #495057;
        margin-bottom: 15px;
        font-size: 1.8rem;
    }

    .empty-state p {
        color: #6c757d;
        margin-bottom: 30px;
        font-size: 1.1rem;
        max-width: 500px;
        margin-left: auto;
        margin-right: auto;
    }

    .browse-btn {
        background: #4a6bff;
        color: white;
        border: none;
        padding: 14px 32px;
        border-radius: 10px;
        font-weight: 600;
        cursor: pointer;
        display: inline-flex;
        align-items: center;
        gap: 10px;
        transition: all 0.3s ease;
        font-size: 1.05rem;
    }

        .browse-btn:hover {
            background: #3a5bef;
            transform: translateY(-3px);
            box-shadow: 0 6px 20px rgba(58, 91, 239, 0.3);
        }

    /* Results Section */
    .results-section {
        animation: fadeIn 0.5s ease;
    }

    @@keyframes fadeIn {
        from {
            opacity: 0;
            transform: translateY(10px);
        }

        to {
            opacity: 1;
            transform: translateY(0);
        }
    }

    .results-header {
        display: flex;
        justify-content: space-between;
        align-items: center;
        margin-bottom: 30px;
        padding-bottom: 20px;
        border-bottom: 2px solid #f1f5f9;
    }

        .results-header h2 {
            margin: 0;
            color: #2d3748;
            font-size: 1.8rem;
            display: flex;
            align-items: center;
            gap: 10px;
        }

    .results-meta {
        display: flex;
        flex-direction: column;
        align-items: flex-end;
        gap: 5px;
    }

    .results-count {
        color: #718096;
        font-size: 0.95rem;
    }

    .page-info {
        background: #4a6bff;
        color: white;
        padding: 4px 12px;
        border-radius: 12px;
        font-size: 0.85rem;
        font-weight: 500;
    }

    /* Stories Grid */
    .stories-grid {
        display: grid;
        grid-template-columns: repeat(auto-fill, minmax(350px, 1fr));
        gap: 25px;
        margin-bottom: 40px;
    }

    @@media (max-width: 768px) {
        .stories-grid {
            grid-template-columns: 1fr;
        }

        .results-header {
            flex-direction: column;
            align-items: flex-start;
            gap: 15px;
        }

        .results-meta {
            align-items: flex-start;
        }
    }

    /* Story Card */
    .story-card {
        background: white;
        border-radius: 15px;
        padding: 25px;
        box-shadow: 0 5px 20px rgba(0, 0, 0, 0.08);
        transition: all 0.3s ease;
        border: 1px solid #e9ecef;
        display: flex;
        flex-direction: column;
        height: 100%;
    }

        .story-card:hover {
            transform: translateY(-5px);
            box-shadow: 0 10px 30px rgba(0, 0, 0, 0.12);
            border-color: #4a6bff;
        }

    .story-card-header {
        margin-bottom: 15px;
        padding-bottom: 15px;
        border-bottom: 1px solid #f1f3f4;
    }

    .story-title {
        font-size: 1.4rem;
        color: #2d3748;
        margin: 0 0 10px 0;
        font-weight: 600;
        line-height: 1.3;
    }

    .story-meta {
        display: flex;
        justify-content: space-between;
        align-items: center;
    }

    .story-date {
        font-size: 0.85rem;
        color: #718096;
        background: #f7fafc;
        padding: 3px 10px;
        border-radius: 12px;
        display: flex;
        align-items: center;
        gap: 5px;
    }

    /* Story Preview */
    .story-preview {
        flex: 1;
        margin-bottom: 20px;
    }

        .story-preview p {
            color: #4a5568;
            line-height: 1.6;
            font-size: 0.95rem;
            margin: 0;
            display: -webkit-box;
            -webkit-line-clamp: 3;
            -webkit-box-orient: vertical;
            overflow: hidden;
        }

    /* Author Section */
    .author-section {
        background: #f8f9fa;
        border-radius: 10px;
        padding: 12px 15px;
        margin-bottom: 20px;
        display: flex;
        justify-content: space-between;
        align-items: center;
    }

    .author-info {
        display: flex;
        align-items: center;
        gap: 8px;
    }

    .author-label {
        color: #6c757d;
        font-size: 0.9rem;
        font-weight: 500;
    }

    .author-name {
        color: #4a6bff;
        text-decoration: none;
        font-weight: 500;
        font-size: 0.95rem;
    }

        .author-name:hover {
            text-decoration: underline;
            color: #3a5bef;
        }

    .author-username {
        font-size: 0.8rem;
        color: #a0aec0;
        background: white;
        padding: 3px 8px;
        border-radius: 4px;
        border: 1px solid #e2e8f0;
    }

    /* Action Buttons */
    .story-actions {
        display: flex;
        gap: 10px;
        align-items: center;
        flex-wrap: wrap;
    }

    .action-btn {
        display: inline-flex;
        align-items: center;
        justify-content: center;
        gap: 8px;
        padding: 10px 18px;
        border-radius: 8px;
        font-weight: 500;
        text-decoration: none;
        transition: all 0.3s ease;
        border: none;
        cursor: pointer;
        font-size: 0.9rem;
        flex: 1;
    }

    .btn-read {
        background: #38a169;
        color: white;
    }

        .btn-read:hover {
            background: #2f855a;
            transform: translateY(-2px);
        }

    .btn-playlist {
        background: #805ad5;
        color: white;
    }

        .btn-playlist:hover {
            background: #6b46c1;
            transform: translateY(-2px);
        }

    .story-id {
        font-size: 0.8rem;
        color: #a0aec0;
        background: #f7fafc;
        padding: 5px 10px;
        border-radius: 4px;
        border: 1px solid #e2e8f0;
        text-align: center;
        flex-basis: 100%;
        margin-top: 10px;
    }

    /* Pagination */
    .pagination {
        display: flex;
        justify-content: space-between;
        align-items: center;
        padding: 25px;
        background: #f8f9fa;
        border-radius: 15px;
        margin: 30px 0;
        flex-wrap: wrap;
        gap: 15px;
    }

    .pagination-btn {
        background: #4a6bff;
        color: white;
        border: none;
        padding: 10px 20px;
        border-radius: 8px;
        font-weight: 500;
        cursor: pointer;
        min-width: 120px;
        transition: all 0.3s ease;
        display: flex;
        align-items: center;
        justify-content: center;
        gap: 8px;
    }

        .pagination-btn:hover:not(.disabled) {
            background: #3a5bef;
            transform: translateY(-2px);
        }

        .pagination-btn.disabled {
            background: #e2e8f0;
            color: #a0aec0;
            cursor: not-allowed;
            transform: none;
        }

    .page-numbers {
        display: flex;
        gap: 8px;
        flex-wrap: wrap;
        justify-content: center;
    }

    .page-number {
        background: white;
        border: 1px solid #e2e8f0;
        color: #4a5568;
        width: 40px;
        height: 40px;
        border-radius: 6px;
        display: flex;
        align-items: center;
        justify-content: center;
        cursor: pointer;
        font-weight: 500;
        transition: all 0.3s ease;
    }

        .page-number:hover {
            background: #f7fafc;
            border-color: #4a6bff;
            color: #4a6bff;
        }

        .page-number.active {
            background: #4a6bff;
            color: white;
            border-color: #4a6bff;
        }

    .page-ellipsis {
        color: #a0aec0;
        padding: 0 5px;
        display: flex;
        align-items: center;
    }

    /* Results Footer */
    .results-footer {
        margin-top: 40px;
    }

    .results-stats {
        display: flex;
        justify-content: center;
        gap: 40px;
        padding: 25px;
        background: #f1f5f9;
        border-radius: 12px;
        flex-wrap: wrap;
    }

    .stat-item {
        display: flex;
        flex-direction: column;
        align-items: center;
        padding: 0 20px;
    }

    .stat-label {
        font-size: 0.9rem;
        color: #64748b;
        margin-bottom: 8px;
        font-weight: 500;
    }

    .stat-value {
        font-size: 1.3rem;
        font-weight: 700;
        color: #4a6bff;
    }
</style>

@code {
    private StorySearchOptionsDtoSearchRequest optionsDto = new StorySearchOptionsDtoSearchRequest()
    {
        PageNumber = 1,
        PageSize = 10,
        Options = new StorySearchOptionsDto()
    };

    private StoryPreviewDtoPageResponse? pageResponse;

    protected override async Task OnInitializedAsync()
    {
        // Load latest stories on initial load
        await LoadLatestStories();
        await base.OnInitializedAsync();
    }

    private async Task LoadLatestStories()
    {
        try
        {
            var apiRes = await clientAli.LastStoriesAsync();

            if (apiRes.Success)
            {
                pageResponse = apiRes;
                StateHasChanged();
            }
            else
            {
                msgService.ShowMessage(apiRes.Message, "error");
            }
        }
        catch (Exception e)
        {
            msgService.ShowMessage(e.Message, "error");
        }
    }

    private async Task LoadPage(int page = 1)
    {
        try
        {
            optionsDto.PageNumber = page;

            var apiRes = await clientAli.SearchResultAsync(optionsDto);

            if (apiRes.Success)
            {
                pageResponse = apiRes;
                StateHasChanged();
            }
            else
            {
                string error = apiRes.Message;
                if (error == "Validation failed")
                {
                    foreach (var err in apiRes.Errors)
                    {
                        error += err;
                    }
                }
                msgService.ShowMessage(error, "error");
            }
        }
        catch (Exception e)
        {
            msgService.ShowMessage(e.Message, "error");
        }
    }

    private void ClearFilters()
    {
        optionsDto = new StorySearchOptionsDtoSearchRequest()
        {
            PageNumber = 1,
            PageSize = 10,
            Options = new StorySearchOptionsDto()
        };
        LoadLatestStories();
    }
}
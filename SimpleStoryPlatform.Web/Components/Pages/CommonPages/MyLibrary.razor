@page "/library"
@rendermode InteractiveServer

<div class="library-container">
    <!-- Header Section -->
    <div class="library-header">
        <h1>📚 My Library</h1>
        <p class="subtitle">Your personal collection of stories</p>
    </div>

    <!-- Loading State -->
    @if (pageResponse == null)
    {
        <div class="loading-state">
            <div class="spinner"></div>
            <p>Loading your library...</p>
        </div>
    }
    else if (!pageResponse.Success)
    {
        <!-- Error State -->
        <div class="error-state">
            <div class="error-icon">⚠️</div>
            <h3>Something went wrong</h3>
            <p>@pageResponse.Message</p>
            @if (pageResponse.Errors?.Any() == true)
            {
                <div class="error-details">
                    @foreach (var error in pageResponse.Errors)
                    {
                        <span class="error-item">• @error</span>
                    }
                </div>
            }
            <button class="retry-btn" @onclick="() => GoToPage(1)">
                🔄 Retry
            </button>
        </div>
    }
    else if (pageResponse.Items == null || !pageResponse.Items.Any())
    {
        <!-- Empty State -->
        <div class="empty-state">
            <div class="empty-icon">📭</div>
            <h3>Your library is empty</h3>
            <p>Start reading stories and add them to your library!</p>
            <a href="/home" class="browse-btn">
                🔍 Browse Stories
            </a>
        </div>
    }
    else
    {
        <!-- Library Content -->
        <div class="library-content">
            <!-- Stories Grid -->
            <div class="stories-grid">
                @foreach (var story in pageResponse.Items)
                {
                    <div class="story-card">
                        <!-- Story Header -->
                        <div class="story-card-header">
                            <h3 class="story-title">@story.Name</h3>
                            <div class="story-meta">
                                <span class="added-date">
                                    📅 Added recently
                                </span>
                            </div>
                        </div>

                        <!-- Story Preview -->
                        <div class="story-preview">
                            <p>@(story.Preview.Length > 150 ? story.Preview.Substring(0, 150) + "..." : story.Preview)</p>
                        </div>

                        <!-- Author Info -->
                        <div class="author-section">
                            <div class="author-info">
                                <span class="author-label">👤 Author:</span>
                                <a href="/user-profile/@story.CreatedBy"
                                   class="author-name">
                                    @story.Writer.FirstName @story.Writer.LastName
                                </a>
                            </div>
                            <span class="author-id">ID: @story.CreatedBy.ToString("N")[..8]...</span>
                        </div>

                        <!-- Action Buttons -->
                        <div class="story-actions">
                            <!-- Read Button -->
                            <a href="/ReadStory/@story.PublicId"
                               class="action-btn btn-read">
                                📖 Read
                            </a>

                            <!-- NEED TO BE FIX THE PLAYLIST SYSTEM TO COMPLETE THIS SECTION -->
                            <!-- NEED TO BE FIX THE PLAYLIST SYSTEM TO COMPLETE THIS SECTION -->
                            <!-- NEED TO BE FIX THE PLAYLIST SYSTEM TO COMPLETE THIS SECTION -->
                            <!-- NEED TO BE FIX THE PLAYLIST SYSTEM TO COMPLETE THIS SECTION -->
                            <!-- Playlist Button (if available) -->
                            @* @if (story.PlayListGuid.HasValue)
                            { *@
                                <a href="/StoryPlayList/@story.PlayListGuid"
                                   class="action-btn btn-playlist">
                                    See Playlist
                                </a>
                            @* } *@

                            <!-- Story ID Info -->
                            <span class="story-id">
                                ID: @story.PublicId.ToString("N")[..8]...
                            </span>
                        </div>
                    </div>
                }
            </div>

            <!-- Pagination -->
            @if (pageResponse.TotalPages > 1)
            {
                <div class="pagination">
                    <!-- Previous Button -->
                    <button class="pagination-btn @(pageResponse.CurrentPage <= 1 ? "disabled" : "")"
                            @onclick="() => GoToPage(pageResponse.CurrentPage - 1)"
                            disabled="@(pageResponse.CurrentPage <= 1)">
                        ◀ Previous
                    </button>

                    <!-- Page Info -->
                    <div class="page-info">
                        <span class="current-page">
                            Page @pageResponse.CurrentPage of @pageResponse.TotalPages
                        </span>
                        <span class="total-items">
                            (@pageResponse.TotalItems total stories)
                        </span>
                        <span class="page-size">
                            Showing @pageResponse.Items.Count() of @pageResponse.TotalItems
                        </span>
                    </div>

                    <!-- Next Button -->
                    <button class="pagination-btn @(pageResponse.CurrentPage >= pageResponse.TotalPages ? "disabled" : "")"
                            @onclick="() => GoToPage(pageResponse.CurrentPage + 1)"
                            disabled="@(pageResponse.CurrentPage >= pageResponse.TotalPages)">
                        Next ▶
                    </button>
                </div>
            }

            <!-- Stats Footer -->
            <div class="library-stats">
                <div class="stat-item">
                    <span class="stat-label">Total Stories:</span>
                    <span class="stat-value">@pageResponse.TotalItems</span>
                </div>
                <div class="stat-item">
                    <span class="stat-label">Current Page:</span>
                    <span class="stat-value">@pageResponse.CurrentPage</span>
                </div>
                <div class="stat-item">
                    <span class="stat-label">Page Size:</span>
                    <span class="stat-value">@pageResponse.PageSize</span>
                </div>
            </div>
        </div>
    }
</div>

<style>
    /* Main Container */
    .library-container {
        max-width: 1200px;
        margin: 0 auto;
        padding: 30px 20px;
        min-height: 80vh;
        font-family: 'Segoe UI', Tahoma, Geneva, Verdana, sans-serif;
    }

    /* Header */
    .library-header {
        text-align: center;
        margin-bottom: 40px;
        padding-bottom: 20px;
        border-bottom: 2px solid #f0f0f0;
    }

        .library-header h1 {
            font-size: 2.5rem;
            color: #333;
            margin-bottom: 10px;
            background: linear-gradient(135deg, #667eea 0%, #764ba2 100%);
            -webkit-background-clip: text;
            -webkit-text-fill-color: transparent;
            background-clip: text;
        }

    .subtitle {
        font-size: 1.1rem;
        color: #666;
        font-weight: 300;
    }

    /* Loading State */
    .loading-state {
        display: flex;
        flex-direction: column;
        align-items: center;
        justify-content: center;
        padding: 60px 20px;
    }

    .spinner {
        width: 50px;
        height: 50px;
        border: 4px solid #f3f3f3;
        border-top: 4px solid #667eea;
        border-radius: 50%;
        animation: spin 1s linear infinite;
        margin-bottom: 20px;
    }

    @@keyframes spin {
        0%

    {
        transform: rotate(0deg);
    }

    100% {
        transform: rotate(360deg);
    }

    }

    .loading-state p {
        color: #666;
        font-size: 1.1rem;
    }

    /* Error State */
    .error-state {
        background: #fff5f5;
        border: 1px solid #fed7d7;
        border-radius: 12px;
        padding: 40px;
        text-align: center;
        margin: 30px 0;
    }

    .error-icon {
        font-size: 3rem;
        margin-bottom: 20px;
    }

    .error-state h3 {
        color: #c53030;
        margin-bottom: 10px;
    }

    .error-state p {
        color: #718096;
        margin-bottom: 20px;
    }

    .error-details {
        margin: 15px 0;
        text-align: left;
        background: white;
        padding: 15px;
        border-radius: 8px;
        border-left: 3px solid #c53030;
    }

    .error-item {
        display: block;
        color: #e53e3e;
        padding: 5px 0;
        font-size: 0.9rem;
    }

    .retry-btn {
        background: #e53e3e;
        color: white;
        border: none;
        padding: 10px 24px;
        border-radius: 6px;
        font-weight: 500;
        cursor: pointer;
        margin-top: 15px;
        display: inline-flex;
        align-items: center;
        gap: 8px;
        transition: background 0.3s ease;
    }

        .retry-btn:hover {
            background: #c53030;
        }

    /* Empty State */
    .empty-state {
        background: #f8f9fa;
        border: 2px dashed #dee2e6;
        border-radius: 12px;
        padding: 60px 40px;
        text-align: center;
    }

    .empty-icon {
        font-size: 4rem;
        margin-bottom: 20px;
        opacity: 0.5;
    }

    .empty-state h3 {
        color: #495057;
        margin-bottom: 10px;
    }

    .empty-state p {
        color: #6c757d;
        margin-bottom: 25px;
    }

    .browse-btn {
        display: inline-block;
        background: #4a6bff;
        color: white;
        text-decoration: none;
        padding: 12px 28px;
        border-radius: 8px;
        font-weight: 500;
        transition: all 0.3s ease;
    }

        .browse-btn:hover {
            background: #3a5bef;
            transform: translateY(-2px);
            box-shadow: 0 4px 12px rgba(58, 91, 239, 0.2);
        }

    /* Stories Grid */
    .stories-grid {
        display: grid;
        grid-template-columns: repeat(auto-fill, minmax(350px, 1fr));
        gap: 25px;
        margin-bottom: 40px;
    }

    @@media (max-width: 768px) {
        .stories-grid

    {
        grid-template-columns: 1fr;
    }

    }

    /* Story Card */
    .story-card {
        background: white;
        border-radius: 12px;
        padding: 25px;
        box-shadow: 0 4px 15px rgba(0, 0, 0, 0.08);
        transition: all 0.3s ease;
        border: 1px solid #e9ecef;
        display: flex;
        flex-direction: column;
        height: 100%;
    }

        .story-card:hover {
            transform: translateY(-5px);
            box-shadow: 0 8px 25px rgba(0, 0, 0, 0.12);
            border-color: #4a6bff;
        }

    .story-card-header {
        margin-bottom: 15px;
        padding-bottom: 15px;
        border-bottom: 1px solid #f1f3f4;
    }

    .story-title {
        font-size: 1.4rem;
        color: #2d3748;
        margin: 0 0 8px 0;
        font-weight: 600;
        line-height: 1.3;
    }

    .story-meta {
        display: flex;
        justify-content: space-between;
        align-items: center;
    }

    .added-date {
        font-size: 0.85rem;
        color: #718096;
        background: #f7fafc;
        padding: 3px 10px;
        border-radius: 12px;
    }

    /* Story Preview */
    .story-preview {
        flex: 1;
        margin-bottom: 20px;
    }

        .story-preview p {
            color: #4a5568;
            line-height: 1.6;
            font-size: 0.95rem;
            margin: 0;
            display: -webkit-box;
            -webkit-line-clamp: 3;
            -webkit-box-orient: vertical;
            overflow: hidden;
        }

    /* Author Section */
    .author-section {
        background: #f8f9fa;
        border-radius: 8px;
        padding: 12px 15px;
        margin-bottom: 20px;
        display: flex;
        justify-content: space-between;
        align-items: center;
    }

    .author-info {
        display: flex;
        align-items: center;
        gap: 8px;
    }

    .author-label {
        color: #6c757d;
        font-size: 0.9rem;
        font-weight: 500;
    }

    .author-name {
        color: #4a6bff;
        text-decoration: none;
        font-weight: 500;
        font-size: 0.95rem;
    }

        .author-name:hover {
            text-decoration: underline;
            color: #3a5bef;
        }

    .author-id {
        font-size: 0.8rem;
        color: #a0aec0;
        background: white;
        padding: 2px 8px;
        border-radius: 4px;
        border: 1px solid #e2e8f0;
    }

    /* Action Buttons */
    .story-actions {
        display: flex;
        gap: 10px;
        align-items: center;
        flex-wrap: wrap;
    }

    .action-btn {
        display: inline-flex;
        align-items: center;
        justify-content: center;
        gap: 6px;
        padding: 10px 18px;
        border-radius: 8px;
        font-weight: 500;
        text-decoration: none;
        transition: all 0.3s ease;
        border: none;
        cursor: pointer;
        font-size: 0.9rem;
    }

    .btn-read {
        background: #38a169;
        color: white;
        flex: 1;
    }

        .btn-read:hover {
            background: #2f855a;
            transform: translateY(-2px);
        }

    .btn-playlist {
        background: #805ad5;
        color: white;
        flex: 1;
    }

        .btn-playlist:hover {
            background: #6b46c1;
            transform: translateY(-2px);
        }

    .story-id {
        font-size: 0.8rem;
        color: #a0aec0;
        background: #f7fafc;
        padding: 5px 10px;
        border-radius: 4px;
        border: 1px solid #e2e8f0;
        text-align: center;
        flex-basis: 100%;
        margin-top: 10px;
    }

    /* Pagination */
    .pagination {
        display: flex;
        justify-content: center;
        align-items: center;
        gap: 20px;
        padding: 25px;
        background: #f8f9fa;
        border-radius: 12px;
        margin: 30px 0;
        flex-wrap: wrap;
    }

    .pagination-btn {
        background: #4a6bff;
        color: white;
        border: none;
        padding: 10px 20px;
        border-radius: 8px;
        font-weight: 500;
        cursor: pointer;
        min-width: 120px;
        transition: all 0.3s ease;
    }

        .pagination-btn:hover:not(.disabled) {
            background: #3a5bef;
            transform: translateY(-2px);
        }

        .pagination-btn.disabled {
            background: #e2e8f0;
            color: #a0aec0;
            cursor: not-allowed;
            transform: none;
        }

    .page-info {
        display: flex;
        flex-direction: column;
        align-items: center;
        gap: 4px;
        text-align: center;
    }

    .current-page {
        font-size: 1rem;
        color: #2d3748;
        font-weight: 500;
    }

    .total-items, .page-size {
        font-size: 0.85rem;
        color: #718096;
    }

    /* Stats Footer */
    .library-stats {
        display: flex;
        justify-content: center;
        gap: 30px;
        padding: 20px;
        background: #f1f5f9;
        border-radius: 10px;
        flex-wrap: wrap;
    }

    .stat-item {
        display: flex;
        flex-direction: column;
        align-items: center;
        padding: 0 15px;
    }

    .stat-label {
        font-size: 0.85rem;
        color: #64748b;
        margin-bottom: 5px;
    }

    .stat-value {
        font-size: 1.2rem;
        font-weight: 600;
        color: #4a6bff;
    }
</style>

@code {
    private StoryPreviewDtoPageResponse pageResponse;
    private BaseRequest request = new BaseRequest() { PageNumber = 1, PageSize = 10 };

    protected override async Task OnInitializedAsync()
    {
        await GoToPage();
    }

    private async Task GoToPage(int page = 1)
    {
        try
        {
            request.PageNumber = page;
            pageResponse = await clientAli.GetLibraryAsync(request);
            StateHasChanged();
        }
        catch (Exception e)
        {
            msgService.ShowMessage(e.Message, "error");
        }
    }
}
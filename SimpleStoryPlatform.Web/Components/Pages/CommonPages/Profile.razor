@page "/profile"
@rendermode InteractiveServer

<div class="profile-container">
    <!-- Loading State -->
    @if (user == null && warningPageRes == null && notifPageRes == null)
    {
        <div class="loading-state">
            <div class="spinner"></div>
            <p>Loading profile...</p>
        </div>
    }
    else
    {
        <div class="profile-content">
            <!-- User Profile Card -->
            <div class="profile-section">
                @if (user != null)
                {
                    <div class="profile-card">
                        <!-- Profile Header -->
                        <div class="profile-header">
                            <div class="avatar">
                                <span class="avatar-icon">👤</span>
                            </div>
                            <div class="profile-info">
                                <h1 class="profile-name">@user.FirstName @user.LastName</h1>
                                <p class="profile-username">@@@user.Username</p>
                                <div class="profile-meta">
                                    <span class="meta-item">
                                        <span class="meta-icon">🎭</span>
                                        <span class="meta-label">Role:</span>
                                        <span class="meta-value @user.Role.ToLower()">@user.Role</span>
                                    </span>
                                    <span class="meta-item">
                                        <span class="meta-icon">📅</span>
                                        <span class="meta-label">Member since:</span>
                                        <span class="meta-value">@user.CreatedAt.ToString("MMMM dd, yyyy")</span>
                                    </span>
                                </div>
                            </div>
                        </div>

                        <!-- Profile Details -->
                        <div class="profile-details">
                            <div class="detail-row">
                                <span class="detail-label">📧 Email</span>
                                <span class="detail-value">@user.Email</span>
                            </div>
                            <div class="detail-row">
                                <span class="detail-label">👤 First Name</span>
                                <span class="detail-value">@user.FirstName</span>
                            </div>
                            <div class="detail-row">
                                <span class="detail-label">👥 Last Name</span>
                                <span class="detail-value">@user.LastName</span>
                            </div>
                            <div class="detail-row">
                                <span class="detail-label">🔤 Username</span>
                                <span class="detail-value">@user.Username</span>
                            </div>
                        </div>
                    </div>
                }

                <!-- Action Buttons -->
                <div class="action-buttons">
                    <button class="action-btn btn-warnings" @onclick="() => GetWarnings(1)">
                        <span class="btn-icon">⚠️</span>
                        <span class="btn-text">View Warnings</span>
                    </button>
                    <button class="action-btn btn-notifications" @onclick="() => GetNotifications(1)">
                        <span class="btn-icon">🔔</span>
                        <span class="btn-text">View Notifications</span>
                    </button>
                </div>
            </div>

            <!-- Warnings Section -->
            @if (warningPageRes != null)
            {
                <div class="section-container">
                    <div class="section-header">
                        <h2>⚠️ Warnings</h2>
                        <div class="section-stats">
                            <span class="stat-badge">Total: @warningPageRes.TotalItems</span>
                            <span class="stat-badge">Page @warningPageRes.CurrentPage of @warningPageRes.TotalPages</span>
                        </div>
                    </div>

                    @if (warningPageRes.Items?.Any() == true)
                    {
                        <div class="warnings-list">
                            @foreach (var warning in warningPageRes.Items)
                            {
                                <div class="warning-card-read">
                                    <div class="warning-header">
                                        <h3 class="warning-subject">@warning.Subject</h3>
                                        <span class="warning-date">
                                            ⏰ @warning.CreatedAt.ToString("MMM dd, yyyy HH:mm")
                                        </span>
                                    </div>
                                    
                                    <div class="warning-content">
                                        <div class="warning-reason">
                                            <strong>Reason:</strong> @warning.Reason
                                        </div>
                                        @if (!string.IsNullOrEmpty(warning.Details))
                                        {
                                            <div class="warning-details">
                                                <strong>Details:</strong> @warning.Details
                                            </div>
                                        }
                                    </div>
                                    
                                    <div class="warning-footer">
                                        <a href="/user-profile/@warning.CreatedBy" class="admin-link">
                                            👤 View Admin's Profile
                                        </a>
                                    </div>
                                </div>
                            }
                        </div>

                        <!-- Warnings Pagination -->
                        @if (warningPageRes.TotalPages > 1)
                        {
                            <div class="pagination">
                                <button class="pagination-btn @(warningPageRes.CurrentPage <= 1 ? "disabled" : "")"
                                        @onclick="() => GetWarnings(warningPageRes.CurrentPage - 1)"
                                        disabled="@(warningPageRes.CurrentPage <= 1)">
                                    ◀ Previous
                                </button>
                                
                                <div class="page-info">
                                    Page @warningPageRes.CurrentPage of @warningPageRes.TotalPages
                                </div>
                                
                                <button class="pagination-btn @(warningPageRes.CurrentPage >= warningPageRes.TotalPages ? "disabled" : "")"
                                        @onclick="() => GetWarnings(warningPageRes.CurrentPage + 1)"
                                        disabled="@(warningPageRes.CurrentPage >= warningPageRes.TotalPages)">
                                    Next ▶
                                </button>
                            </div>
                        }
                    }
                    else
                    {
                        <div class="empty-section">
                            <div class="empty-icon">✅</div>
                            <h3>No warnings found</h3>
                            <p>You have no warnings in your account.</p>
                        </div>
                    }
                </div>
            }

            <!-- Notifications Section -->
            @if (notifPageRes != null)
            {
                <div class="section-container">
                    <div class="section-header">
                        <h2>🔔 Notifications</h2>
                        <div class="section-stats">
                            <span class="stat-badge">Total: @notifPageRes.TotalItems</span>
                            <span class="stat-badge">Page @notifPageRes.CurrentPage of @notifPageRes.TotalPages</span>
                        </div>
                    </div>

                    @if (notifPageRes.Items?.Any() == true)
                    {
                        <div class="notifications-list">
                            @foreach (var notif in notifPageRes.Items)
                            {
                                <div class="notification-card @(notif.IsReaded ? "read" : "unread")">
                                    <div class="notification-header">
                                        <h3 class="notification-subject">@notif.Subject</h3>
                                        <span class="notification-date">
                                            ⏰ @notif.CreatedAt.ToString("MMM dd, yyyy HH:mm")
                                        </span>
                                    </div>
                                    
                                    <div class="notification-content">
                                        <p class="notification-text">@notif.Text</p>
                                    </div>
                                    
                                    @if (!notif.IsReaded)
                                    {
                                        <div class="notification-badge">NEW</div>
                                    }
                                </div>
                            }
                        </div>

                        <!-- Notifications Pagination -->
                        @if (notifPageRes.TotalPages > 1)
                        {
                            <div class="pagination">
                                <button class="pagination-btn @(notifPageRes.CurrentPage <= 1 ? "disabled" : "")"
                                        @onclick="() => GetNotifications(notifPageRes.CurrentPage - 1)"
                                        disabled="@(notifPageRes.CurrentPage <= 1)">
                                    ◀ Previous
                                </button>
                                
                                <div class="page-info">
                                    Page @notifPageRes.CurrentPage of @notifPageRes.TotalPages
                                </div>
                                
                                <button class="pagination-btn @(notifPageRes.CurrentPage >= notifPageRes.TotalPages ? "disabled" : "")"
                                        @onclick="() => GetNotifications(notifPageRes.CurrentPage + 1)"
                                        disabled="@(notifPageRes.CurrentPage >= notifPageRes.TotalPages)">
                                    Next ▶
                                </button>
                            </div>
                        }
                    }
                    else
                    {
                        <div class="empty-section">
                            <div class="empty-icon">📭</div>
                            <h3>No notifications</h3>
                            <p>You have no notifications at the moment.</p>
                        </div>
                    }
                </div>
            }
        </div>
    }
</div>

<style>
    /* Main Container */
    .profile-container {
        max-width: 1200px;
        margin: 0 auto;
        padding: 30px 20px;
        min-height: 80vh;
        font-family: 'Segoe UI', Tahoma, Geneva, Verdana, sans-serif;
    }

    /* Loading State */
    .loading-state {
        display: flex;
        flex-direction: column;
        align-items: center;
        justify-content: center;
        padding: 100px 20px;
    }

    .spinner {
        width: 60px;
        height: 60px;
        border: 5px solid #f3f3f3;
        border-top: 5px solid #4a6bff;
        border-radius: 50%;
        animation: spin 1s linear infinite;
        margin-bottom: 20px;
    }

    @@keyframes spin {
        0% { transform: rotate(0deg); }
        100% { transform: rotate(360deg); }
    }

    .loading-state p {
        color: #666;
        font-size: 1.2rem;
    }

    /* Profile Content */
    .profile-content {
        display: flex;
        flex-direction: column;
        gap: 30px;
    }

    .profile-section {
        display: flex;
        flex-direction: column;
        gap: 20px;
    }

    /* Profile Card */
    .profile-card {
        background: white;
        border-radius: 20px;
        padding: 30px;
        box-shadow: 0 10px 30px rgba(0, 0, 0, 0.08);
        border: 1px solid #e9ecef;
    }

    .profile-header {
        display: flex;
        align-items: center;
        gap: 25px;
        margin-bottom: 30px;
        padding-bottom: 25px;
        border-bottom: 2px solid #f1f5f9;
    }

    .avatar {
        width: 100px;
        height: 100px;
        background: linear-gradient(135deg, #4a6bff 0%, #3a5bef 100%);
        border-radius: 50%;
        display: flex;
        align-items: center;
        justify-content: center;
        box-shadow: 0 8px 25px rgba(74, 107, 255, 0.3);
    }

    .avatar-icon {
        font-size: 3.5rem;
        color: white;
    }

    .profile-info {
        flex: 1;
    }

    .profile-name {
        font-size: 2.2rem;
        color: #2d3748;
        margin: 0 0 5px 0;
        font-weight: 700;
        line-height: 1.2;
    }

    .profile-username {
        font-size: 1.1rem;
        color: #718096;
        margin: 0 0 15px 0;
    }

    .profile-meta {
        display: flex;
        gap: 25px;
        flex-wrap: wrap;
    }

    .meta-item {
        display: flex;
        align-items: center;
        gap: 8px;
        background: #f8f9fa;
        padding: 8px 15px;
        border-radius: 10px;
        border: 1px solid #e2e8f0;
    }

    .meta-icon {
        font-size: 1rem;
    }

    .meta-label {
        color: #64748b;
        font-weight: 500;
        font-size: 0.9rem;
    }

    .meta-value {
        font-weight: 600;
        color: #2d3748;
        font-size: 0.9rem;
    }

    .meta-value.admin {
        color: #805ad5;
        background: rgba(128, 90, 213, 0.1);
        padding: 2px 8px;
        border-radius: 4px;
    }

    .meta-value.user {
        color: #38a169;
        background: rgba(56, 161, 105, 0.1);
        padding: 2px 8px;
        border-radius: 4px;
    }

    .meta-value.writer {
        color: #dd6b20;
        background: rgba(221, 107, 32, 0.1);
        padding: 2px 8px;
        border-radius: 4px;
    }

    /* Profile Details */
    .profile-details {
        display: grid;
        grid-template-columns: repeat(auto-fit, minmax(250px, 1fr));
        gap: 20px;
    }

    .detail-row {
        background: #f8f9fa;
        padding: 15px 20px;
        border-radius: 12px;
        border: 1px solid #e2e8f0;
        display: flex;
        justify-content: space-between;
        align-items: center;
    }

    .detail-label {
        color: #64748b;
        font-weight: 500;
        font-size: 0.95rem;
        display: flex;
        align-items: center;
        gap: 8px;
    }

    .detail-value {
        color: #2d3748;
        font-weight: 600;
        font-size: 1rem;
    }

    /* Action Buttons */
    .action-buttons {
        display: flex;
        gap: 15px;
        flex-wrap: wrap;
    }

    .action-btn {
        flex: 1;
        min-width: 200px;
        background: white;
        border: 2px solid #e2e8f0;
        border-radius: 12px;
        padding: 18px 25px;
        display: flex;
        align-items: center;
        justify-content: center;
        gap: 12px;
        cursor: pointer;
        transition: all 0.3s ease;
        font-size: 1rem;
        font-weight: 600;
    }

    .action-btn:hover {
        transform: translateY(-3px);
        box-shadow: 0 8px 25px rgba(0, 0, 0, 0.1);
    }

    .btn-warnings:hover {
        border-color: #e53e3e;
        color: #e53e3e;
    }

    .btn-notifications:hover {
        border-color: #4a6bff;
        color: #4a6bff;
    }

    .btn-icon {
        font-size: 1.3rem;
    }

    .btn-text {
        font-size: 1.05rem;
    }

    /* Section Containers */
    .section-container {
        background: white;
        border-radius: 20px;
        padding: 30px;
        box-shadow: 0 10px 30px rgba(0, 0, 0, 0.08);
        border: 1px solid #e9ecef;
        animation: slideIn 0.5s ease;
    }

    @@keyframes slideIn {
        from {
            opacity: 0;
            transform: translateY(20px);
        }
        to {
            opacity: 1;
            transform: translateY(0);
        }
    }

    .section-header {
        display: flex;
        justify-content: space-between;
        align-items: center;
        margin-bottom: 25px;
        padding-bottom: 20px;
        border-bottom: 2px solid #f1f5f9;
        flex-wrap: wrap;
        gap: 15px;
    }

    .section-header h2 {
        margin: 0;
        color: #2d3748;
        font-size: 1.8rem;
        display: flex;
        align-items: center;
        gap: 10px;
    }

    .section-stats {
        display: flex;
        gap: 10px;
    }

    .stat-badge {
        background: #f1f5f9;
        color: #64748b;
        padding: 6px 12px;
        border-radius: 20px;
        font-size: 0.85rem;
        font-weight: 500;
        border: 1px solid #e2e8f0;
    }

    /* Warnings & Notifications Lists */
    .warnings-list, .notifications-list {
        display: flex;
        flex-direction: column;
        gap: 15px;
    }

    /* Warning Card */
    .warning-card {
        background: white;
        border-radius: 12px;
        padding: 20px;
        border: 2px solid #fed7d7;
        border-left: 5px solid #e53e3e;
        transition: all 0.3s ease;
    }

    .warning-card.unread {
        background: #fff5f5;
        border-color: #fc8181;
    }

    .warning-card.read {
        border-color: #e2e8f0;
        border-left-color: #a0aec0;
        opacity: 0.8;
    }

    .warning-card:hover {
        transform: translateX(5px);
        box-shadow: 0 5px 15px rgba(229, 62, 62, 0.1);
    }

    .warning-header {
        display: flex;
        justify-content: space-between;
        align-items: center;
        margin-bottom: 15px;
        flex-wrap: wrap;
        gap: 10px;
    }

    .warning-subject {
        margin: 0;
        color: #c53030;
        font-size: 1.2rem;
        font-weight: 600;
    }

    .warning-date {
        color: #718096;
        font-size: 0.9rem;
        display: flex;
        align-items: center;
        gap: 5px;
    }

    .warning-content {
        margin-bottom: 15px;
    }

    .warning-reason, .warning-details {
        margin: 8px 0;
        color: #4a5568;
        line-height: 1.5;
    }

    .warning-reason strong, .warning-details strong {
        color: #2d3748;
    }

    .warning-footer {
        display: flex;
        justify-content: flex-end;
    }

    .admin-link {
        color: #4a6bff;
        text-decoration: none;
        font-weight: 500;
        font-size: 0.9rem;
        display: flex;
        align-items: center;
        gap: 5px;
        transition: color 0.3s ease;
    }

    .admin-link:hover {
        color: #3a5bef;
        text-decoration: underline;
    }

    /* Notification Card */
    .notification-card {
        background: white;
        border-radius: 12px;
        padding: 20px;
        border: 2px solid #bee3f8;
        border-left: 5px solid #4299e1;
        position: relative;
        transition: all 0.3s ease;
    }

    .notification-card.unread {
        background: #ebf8ff;
        border-color: #90cdf4;
    }

    .notification-card.read {
        border-color: #e2e8f0;
        border-left-color: #a0aec0;
        opacity: 0.8;
    }

    .notification-card:hover {
        transform: translateX(5px);
        box-shadow: 0 5px 15px rgba(66, 153, 225, 0.1);
    }

    .notification-header {
        display: flex;
        justify-content: space-between;
        align-items: center;
        margin-bottom: 15px;
        flex-wrap: wrap;
        gap: 10px;
    }

    .notification-subject {
        margin: 0;
        color: #2b6cb0;
        font-size: 1.2rem;
        font-weight: 600;
    }

    .notification-date {
        color: #718096;
        font-size: 0.9rem;
        display: flex;
        align-items: center;
        gap: 5px;
    }

    .notification-content {
        margin-bottom: 10px;
    }

    .notification-text {
        margin: 0;
        color: #4a5568;
        line-height: 1.6;
    }

    .notification-badge {
        position: absolute;
        top: -8px;
        right: -8px;
        background: #e53e3e;
        color: white;
        padding: 4px 10px;
        border-radius: 12px;
        font-size: 0.75rem;
        font-weight: 700;
        animation: pulse 2s infinite;
    }

    @@keyframes pulse {
        0%, 100% { transform: scale(1); }
        50% { transform: scale(1.05); }
    }

    /* Empty States */
    .empty-section {
        text-align: center;
        padding: 40px 20px;
    }

    .empty-icon {
        font-size: 4rem;
        margin-bottom: 20px;
        opacity: 0.5;
    }

    .empty-section h3 {
        color: #495057;
        margin-bottom: 10px;
        font-size: 1.5rem;
    }

    .empty-section p {
        color: #6c757d;
        margin: 0;
        font-size: 1rem;
    }

    /* Pagination */
    .pagination {
        display: flex;
        justify-content: center;
        align-items: center;
        gap: 20px;
        padding: 25px 0 10px 0;
        margin-top: 20px;
        border-top: 1px solid #e2e8f0;
    }

    .pagination-btn {
        background: #4a6bff;
        color: white;
        border: none;
        padding: 10px 20px;
        border-radius: 8px;
        font-weight: 500;
        cursor: pointer;
        min-width: 120px;
        transition: all 0.3s ease;
    }

    .pagination-btn:hover:not(.disabled) {
        background: #3a5bef;
        transform: translateY(-2px);
    }

    .pagination-btn.disabled {
        background: #e2e8f0;
        color: #a0aec0;
        cursor: not-allowed;
        transform: none;
    }

    .page-info {
        color: #64748b;
        font-weight: 500;
        font-size: 0.95rem;
    }

    /* Responsive Design */
    @@media (max-width: 768px) {
        .profile-container {
            padding: 20px 15px;
        }
        
        .profile-card, .section-container {
            padding: 20px;
        }
        
        .profile-header {
            flex-direction: column;
            text-align: center;
            gap: 20px;
        }
        
        .profile-meta {
            justify-content: center;
        }
        
        .section-header {
            flex-direction: column;
            align-items: flex-start;
        }
        
        .section-stats {
            width: 100%;
            justify-content: flex-start;
        }
        
        .action-buttons {
            flex-direction: column;
        }
        
        .action-btn {
            min-width: 100%;
        }
        
        .detail-row {
            flex-direction: column;
            align-items: flex-start;
            gap: 5px;
        }
        
        .warning-header, .notification-header {
            flex-direction: column;
            align-items: flex-start;
            gap: 10px;
        }
        
        .pagination {
            flex-direction: column;
            gap: 15px;
        }
        
        .pagination-btn {
            width: 100%;
        }
    }
</style>

@code {
    private BaseRequest request = new BaseRequest() { PageNumber = 1, PageSize = 10 };
    private UserDetailsDto? user;
    private WarningDtoPageResponse? warningPageRes;
    private NotificationDtoPageResponse? notifPageRes;
    
    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        await base.OnAfterRenderAsync(firstRender);
        if (firstRender)
        {
            await LoadProfile();
        }
    }
    
    private async Task LoadProfile()
    {
        try
        {
            var apiRes = await clientAli.ProfileAsync();
            
            if (apiRes.Success)
            {
                user = apiRes.Data;
                StateHasChanged();
            }
            else
            {
                msgService.ShowMessage(apiRes.Message, "error");
            }
        }
        catch (Exception e)
        { 
            msgService.ShowMessage(e.Message, "error"); 
        }
    }
    
    private async Task GetWarnings(int page = 1)
    {
        request.PageNumber = page;
        try
        {
            var apiRes = await clientAli.GetWarningsAsync(request);
            
            if (apiRes.Success)
            {
                warningPageRes = apiRes;
                StateHasChanged();
            }
            else
            {
                msgService.ShowMessage(apiRes.Message, "error");
            }
        }
        catch (Exception e)
        { 
            msgService.ShowMessage(e.Message, "error"); 
        }
    }
    
    private async Task GetNotifications(int page = 1)
    {
        request.PageNumber = page;
        try
        {
            var apiRes = await clientAli.GetNotificationsAsync(request);
            
            if (apiRes.Success)
            {
                notifPageRes = apiRes;
                StateHasChanged();
            }
            else
            {
                msgService.ShowMessage(apiRes.Message, "error");
            }
        }
        catch (Exception e)
        { 
            msgService.ShowMessage(e.Message, "error"); 
        }
    }
}